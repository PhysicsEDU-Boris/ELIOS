# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
lib/firebase_options.dart

# Environment files
.env
.env.*
!.env.example
.env.local
.env.*.local

# Firestore seed local files
firestore-seed/serviceAccountKey.json
firestore-seed/
references/
node_modules/

# Environment files (only the placeholder template is tracked)
.env*
!.env.example

# Firebase config with real keys: never commit. Use the *.example templates.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Signing material
key.properties
**/android/key.properties
*.jks
*.keystore

# On-device Gemma model (~2.59 GB). Each machine places it manually,
# see README "Gemma model". Never commit it.
*.litertlm
/models/
assets/models/*.litertlm
assets/models/*.tflite

# Local agent and tooling state
.claude/
.codegraph/

# Local M2c debug crops and JSONL traces (including copied robot artifacts)
**/m2c-diagnostics/
scan-*-identify.jpg
scan-*.jsonl

# MaixVision package build output (rebuild from firmware/maixcam2/app.yaml + main.py)
firmware/maixcam2/dist/

# Cloud AI bench raw replies and any photos copied in by mistake
tools/cloud_ai_bench/raw/
tools/cloud_ai_bench/**/*.jpg
tools/cloud_ai_bench/**/*.jpeg
tools/cloud_ai_bench/**/*.png
tools/cloud_ai_bench/**/*.heic

# Cloudflare Worker local state
worker/.wrangler/
