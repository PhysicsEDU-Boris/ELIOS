#!/usr/bin/env bash
# Blocks a push when any commit being pushed adds a key-like string.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

remote="$1"
zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch delete, nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes="$remote")
  else
    range=("$remote_sha..$local_sha")
  fi
  echo "pre-push: checking $local_ref -> $remote_ref"
  "$root/scripts/check-secrets.sh" --log "${range[@]}" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: blocked. Remove the keys from history before pushing." >&2
fi
exit "$status"
